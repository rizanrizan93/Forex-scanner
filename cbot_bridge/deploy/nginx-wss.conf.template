# Replace __HOSTNAME__ only after DuckDNS and a trusted certificate are verified.
map $http_upgrade $rizan_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 25345 ssl;
    listen [::]:25345 ssl;
    server_name __HOSTNAME__;
    ssl_certificate /etc/letsencrypt/live/__HOSTNAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__HOSTNAME__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    access_log off;

    location / {
        proxy_pass http://127.0.0.1:25346;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $rizan_connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        proxy_buffering off;
    }
}
