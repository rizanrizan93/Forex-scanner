# No secrets should be committed.
FX_ENV=live
FX_DATA_DIR=./data

# Operational database: dedicated Forex scanner Supabase project.
SUPABASE_PROJECT_REF=naxvdtvlfatljzzwhrmo
SUPABASE_URL=https://naxvdtvlfatljzzwhrmo.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallback only; prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Production safety defaults: LIVE account context is READ-ONLY.
FX_LIVE_TRADING_ENABLED=0
FX_BROKER_ACCOUNT_ALLOWLIST=
FX_KILL_SWITCH=1
FX_IDEMPOTENCY_STATE_PATH=./state/execution_idempotency.json

# FP Markets cTrader Open API - LIVE read-only account context.
# Authorize the token with OAuth scope=accounts (SCOPE_VIEW). Tokens with
# trading scope are rejected by src/fx_scanner/live_account_readonly.py.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_TOKEN_STATE_PATH=./state/ctrader_tokens.json
CTRADER_TRADER_LOGIN=
# Optional pin. If set, it must equal the ID resolved from CTRADER_TRADER_LOGIN.
CTRADER_ACCOUNT_ID=
# DEMO execution is retired for the live cutover.
CTRADER_DEMO_AUTOTRADE_ENABLED=0
# Retained only for historical/replay compatibility; not used by LIVE monitor.
CTRADER_DEMO_ENTRY_ZONE_TOLERANCE_ATR=0.05

# HFM Cent MT5 - deferred/future execution venue. Never commit real credentials.
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_SERVER=
MT5_PASSWORD=
