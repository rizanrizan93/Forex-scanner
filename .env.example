# No secrets should be committed.
FX_ENV=research
FX_DATA_DIR=./data

# Operational database: dedicated Forex scanner Supabase project.
SUPABASE_PROJECT_REF=fotzcxjeypmjldhvfskt
SUPABASE_URL=https://fotzcxjeypmjldhvfskt.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallback only; prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Execution defaults are DISABLED. Live trading requires ALL safety gates.
FX_LIVE_TRADING_ENABLED=
FX_BROKER_ACCOUNT_ALLOWLIST=
FX_KILL_SWITCH=0
FX_IDEMPOTENCY_STATE_PATH=./state/execution_idempotency.json

# FP Markets cTrader Open API - RESEARCH FEED ONLY.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_TOKEN_STATE_PATH=./state/ctrader_tokens.json
CTRADER_TRADER_LOGIN=
# Optional pin. If set, it must equal the ID resolved from CTRADER_TRADER_LOGIN.
CTRADER_ACCOUNT_ID=

# HFM Cent MT5 - EXECUTION VENUE ONLY. Never commit real credentials.
MT5_TERMINAL_PATH=
MT5_LOGIN=
