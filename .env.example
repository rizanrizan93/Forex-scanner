# No secrets should be committed.
FX_ENV=research
FX_DATA_DIR=./data

# Operational database (future dedicated FX Supabase project).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Execution defaults are DISABLED. Live trading requires ALL safety gates.
FX_LIVE_TRADING_ENABLED=
FX_BROKER_ACCOUNT_ALLOWLIST=
FX_KILL_SWITCH=0

# cTrader Open API (preferred backend). Obtain after registering/approving an Open API app.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=

# MT5 fallback collector/execution host.
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_SERVER=
MT5_PASSWORD=
